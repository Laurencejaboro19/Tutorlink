# ---- TutorLink environment (copy to .env.local; never commit real values) ----

# PostgreSQL connection string (Neon / Vercel Postgres / Supabase / local)
DATABASE_URL=postgres://user:password@host:5432/tutorlink?sslmode=require

# Public base URL of the deployed app (used for redirect URLs, referral links, emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32+ random bytes, base64 or hex. Used to sign/hash session + verification tokens.
AUTH_SECRET=change-me-to-a-long-random-string

# Flutterwave (TEST keys from https://dashboard.flutterwave.com -> Settings -> API)
# Live keys only after the go-live checklist in README.md.
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxx-X
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxx-X
# Secret hash you typed into Dashboard -> Settings -> Webhooks. Compared with the verif-hash header.
FLUTTERWAVE_WEBHOOK_HASH=change-me
# "test" or "live". Payouts (transfers) are refused unless PAYOUTS_ENABLED=true AND mode is live.
FLUTTERWAVE_MODE=test
PAYOUTS_ENABLED=false

# Shared secret that Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me

# Bootstrap: the first account registered with this email becomes a super admin.
ADMIN_BOOTSTRAP_EMAIL=you@example.com

# Optional email provider (Resend). When unset, verification links are logged server-side
# and surfaced on the "check your inbox" page in non-production environments only.
RESEND_API_KEY=
EMAIL_FROM=TutorLink <no-reply@example.com>
